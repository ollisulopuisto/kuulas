#!/bin/bash
# Send a prompt to a specific, existing opencode session through the opencode
# server's HTTP API (the coordinator wakes the interactive session this way).
#
#   oc-remote list                    sessions for this repo
#   oc-remote send SESSION_ID TEXT    queue a prompt, do not wait
#   oc-remote history SESSION_ID      conversation so far (JSON)
#
# The password is the server's own OPENCODE_SERVER_PASSWORD, read at run time
# from its launchd plist (never printed, never on a command line). To use
# another source, set OPENCODE_REMOTE_PASSWORD_FILE to a one-line file.
# Override the server with OPENCODE_REMOTE_URL (default http://127.0.0.1:4096).
set -euo pipefail

BASE_URL="${OPENCODE_REMOTE_URL:-http://127.0.0.1:4096}"
USERNAME="${OPENCODE_SERVER_USERNAME:-opencode}"
PLIST="${OPENCODE_REMOTE_PLIST:-$HOME/Library/LaunchAgents/ai.opencode.server.plist}"

password() {
  if [[ -n "${OPENCODE_REMOTE_PASSWORD_FILE:-}" ]]; then
    tr -d '\n' <"$OPENCODE_REMOTE_PASSWORD_FILE"
  else
    python3 -I -c 'import plistlib,sys
sys.stdout.write(plistlib.load(open(sys.argv[1],"rb"))["EnvironmentVariables"]["OPENCODE_SERVER_PASSWORD"])' "$PLIST"
  fi
}

api() {
  # The credentials go through a curl config on stdin, so they never appear
  # in the process list or the shell history.
  { printf 'user = "%s:' "$USERNAME"; password; printf '"\n'; } |
    curl --fail --silent --show-error --max-time 30 --config - \
      -H 'Content-Type: application/json' "$@"
}

valid_id() { [[ "$1" =~ ^[a-zA-Z0-9_-]+$ ]] || { echo "Invalid session ID" >&2; exit 2; }; }

case "${1:-}" in
  list)
    api "$BASE_URL/session" | jq -r '.[] | [.id, .directory, (.title // ""), (.time.updated // 0)] | @tsv'
    ;;
  send)
    [[ $# -ge 3 ]] || { echo 'Usage: oc-remote send SESSION_ID "text"' >&2; exit 2; }
    id="$2"; shift 2; valid_id "$id"
    payload=$(jq -n --arg p "$*" '{parts:[{type:"text",text:$p}]}')
    api -X POST "$BASE_URL/session/$id/prompt_async" --data "$payload" -o /dev/null
    echo "Prompt submitted to $id"
    ;;
  history)
    [[ $# -eq 2 ]] || { echo 'Usage: oc-remote history SESSION_ID' >&2; exit 2; }
    valid_id "$2"
    api "$BASE_URL/session/$2/message"
    ;;
  *)
    echo 'Usage: oc-remote {list|send|history} ...' >&2; exit 2
    ;;
esac
